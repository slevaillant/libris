{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "libris",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/server.js",
  "assets": {
    "directory": "dist/client"
  },
  "triggers": {
    // Daily Substack sync · Sunday pattern analysis · Friday 12:00 Paris digest (10:00 UTC in CEST, 11:00 UTC in CET)
    "crons": ["0 8 * * *", "0 8 * * SUN", "0 10 * * FRI", "0 11 * * FRI"]
  }
}
